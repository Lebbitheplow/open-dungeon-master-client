# Maintainer: Kaleb Lutterman
# AUR template repacking the released Linux tar.gz from GitHub Releases.
# Per release: bump pkgver, update sha256sums (curl the .tar.gz and
# sha256sum it; never ship SKIP once the repo is public), regenerate
# .SRCINFO with `makepkg --printsrcinfo > .SRCINFO`.
#
# The app ships an in-app updater, but installs living under /opt (this
# package) are detected as the "managed" kind and deliberately defer to
# pacman: the app only announces new versions, it never rewrites files that
# a package manager owns.
pkgname=open-game-master-client-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop client for Open Game Master, the self-hostable TTRPG platform"
arch=('x86_64')
url="https://opengamemaster.com"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss')
provides=('open-game-master-client')
options=('!strip')
source=("open-game-master-client-${pkgver}-x64.tar.gz::https://github.com/Lebbitheplow/open-game-master-client/releases/download/v${pkgver}/open-game-master-client-${pkgver}-x64.tar.gz")
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/open-game-master"
  cp -a "$srcdir"/*/. "$pkgdir/opt/open-game-master/"
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/open-game-master/open-game-master-client" \
    "$pkgdir/usr/bin/open-game-master-client"
  install -Dm644 /dev/stdin \
    "$pkgdir/usr/share/applications/open-game-master-client.desktop" <<'EOF'
[Desktop Entry]
Name=Open Game Master
Comment=Multiplayer TTRPG campaigns with an AI or human Game Master
Exec=/opt/open-game-master/open-game-master-client %u
Terminal=false
Type=Application
Categories=Game;
MimeType=x-scheme-handler/odm;
EOF
}
