{
  "name": "open-dungeon-master-mobile",
  "version": "0.5.0",
  "private": true,
  "description": "Android client for Open Dungeon Master: hosts a world on the phone, or connects to any server",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "bundle-payload": "node scripts/bundle-android-payload.mjs",
    "sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^7.3.2",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/barcode-scanner": "^2.2.6",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.4",
    "@capgo/inappbrowser": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@fontsource/cinzel": "^5.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
