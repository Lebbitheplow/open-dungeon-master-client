<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Always the dark night theme: the app has no light mode, so the
         system bars keep light icons whatever the device setting. The bars
         themselves are transparent (MainActivity enables edge to edge on
         every Android version; the statusBarColor and navigationBarColor
         attributes are deprecated since Android 15), so the window
         background is what shows behind them. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/odm_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The manager page runs inside the system bars (Capacitor's
         adjustMarginsForEdgeToEdge: force), and the window background shows
         through behind them in the same night color as the page. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/odm_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- The launch screen: the d20 at a fixed size on the night color, drawn
         by the system splash screen (core-splashscreen below Android 12).
         MainActivity installs it, which also moves the activity on to the
         theme above; never a bitmap as android:background here, which
         Android stretches to each view's shape and hands to every view
         that has no background of its own. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/odm_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
