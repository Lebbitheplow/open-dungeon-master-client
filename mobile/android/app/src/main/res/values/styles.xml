<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Always the dark night theme: the app has no light mode, so the
         system bars keep light icons whatever the device setting. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/odm_night</item>
        <item name="android:statusBarColor">@color/odm_night</item>
        <item name="android:navigationBarColor">@color/odm_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The manager page runs inside the system bars (Capacitor's
         adjustMarginsForEdgeToEdge: force), and the window background shows
         through behind them in the same night color as the page. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/odm_night</item>
        <item name="android:statusBarColor">@color/odm_night</item>
        <item name="android:navigationBarColor">@color/odm_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
